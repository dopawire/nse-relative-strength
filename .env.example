# Copy to .env (never commit .env) and fill in.

# Your domain, pointed (DNS A record) at the server: Caddy gets HTTPS for it.
# Leave ":80" only for a first plain-HTTP test, with NSE_RS_COOKIE_SECURE=0.
SITE_ADDRESS=rs.example.com

# Session signing key: generate with  openssl rand -hex 32
NSE_RS_SECRET=change-me

# Login cookies only over HTTPS (keep 1 in production).
NSE_RS_COOKIE_SECURE=1
NSE_RS_SESSION_DAYS=14

# Optional: create the first admin on first start (remove afterwards).
# NSE_RS_ADMIN_USER=you
# NSE_RS_ADMIN_PASSWORD=a-long-password

# Optional Telegram evening brief + failure alerts (see send_brief.py).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_OK=0
